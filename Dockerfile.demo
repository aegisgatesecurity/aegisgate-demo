# AegisGate Demo - Production Dockerfile v3.6.2
# ===============================================
#
# This Dockerfile builds the demo environment with the CURRENT platform binary.
# Updated: August 4, 2026 — Full aesthetic overhaul + v3.6.2 binary
#
# Features:
#   1. Alpine 3.19 base (stable, working apk repos)
#   2. AegisGate v3.6.2 platform binary (latest release)
#   3. Corporate v4.0 aesthetic (Space Grotesk + Inter fonts, glass morphism)
#   4. SendGrid email integration (direct API, no middleman)
#   5. Nginx reverse proxy + Python signup server + Platform in demo mode

# ============================================
# Stage 1: Base image
# ============================================
FROM alpine:3.19 AS base

# Install all the packages we need in one go
# alpine:3.19 has the standard alpine repos (no need for --repository flag)
RUN apk add --no-cache \
        bash \
        curl \
        tini \
        nginx \
        python3 \
        py3-pip \
        ca-certificates \
        tzdata && \
    pip3 install --break-system-packages requests

# ============================================
# Stage 2: Add demo-specific files
# ============================================
FROM base AS demo

# Demo mode env vars
ENV AEGISGATE_MODE=demo
ENV AEGISGATE_LOG_LEVEL=info
ENV AEGISGATE_DEMO_RESET_HOURS=24
ENV AEGISGATE_DEMO_MAX_REQUESTS_PER_HOUR=100
ENV AEGISGATE_DEMO_RANDOM_SEED="aegisgate-demo-2026-06"
ENV PYTHONUNBUFFERED=1

# Copy the pre-built platform binary (v3.6.2)
# This binary was built locally from the v3.6.2 source
COPY aegisgate-platform /usr/local/bin/aegisgate-platform
RUN chmod +x /usr/local/bin/aegisgate-platform

# Set version label for tracking
LABEL aegisgate.version="3.6.2"
LABEL aegisgate.demo.updated="2026-08-04"

# Copy demo-specific files
COPY seed-data/ /opt/aegisgate-demo/seed-data/
COPY email-signup/ /opt/aegisgate-demo/email-signup/
COPY scripts/ /opt/aegisgate-demo/scripts/
COPY nginx/ /opt/aegisgate-demo/nginx/
COPY dashboard/ /opt/aegisgate-demo/dashboard/
COPY scripts/demo-banner.css /opt/aegisgate-demo/demo-banner.css
COPY scripts/demo-banner.js /opt/aegisgate-demo/demo-banner.js

# Make scripts executable
RUN chmod +x /opt/aegisgate-demo/scripts/*.sh

# Create data directories (ephemeral on free tier, no disk mount)
RUN mkdir -p /data /data/signups /data/seed /data/audit && \
    chmod 777 /data /data/signups /data/seed /data/audit

# Create nginx runtime directories
RUN mkdir -p /var/log/nginx /var/lib/nginx /run/nginx /var/cache/nginx

# Expose port 8080 (Render's expected port for free tier)
# Why 8080? Render's port detection sometimes ignores EXPOSE 80 and uses 8080
# by default. To ensure consistency, we run nginx on 8080 (which is also where
# the platform normally listens). nginx is the public-facing service now.
EXPOSE 8080

# Health check (Render will hit this every 30s)
# nginx is now on port 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:8080/health || exit 1

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--", "/opt/aegisgate-demo/scripts/entrypoint.sh"]
