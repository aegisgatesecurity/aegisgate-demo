# AegisGate Demo - Rebuilt Dockerfile
# =====================================
#
# This Dockerfile builds the demo environment using a known-good base
# (Alpine 3.19) and the platform binary we built locally. The previous
# approach of using the platform's Docker image failed because:
#   1. The 'main' tag on GHCR is stale (points to v1.3.7 from May 2026)
#   2. The platform's base image has no working apk repos
#
# This approach:
#   1. Uses Alpine 3.19 (well-maintained, has working apk repos)
#   2. Copies the platform binary from the build context
#   3. Installs nginx, python3, etc. via standard alpine packages
#   4. Has the actual v3.3.0-beta.2-demo code (not the stale v1.3.7)

# ============================================
# Stage 1: Base image
# ============================================
FROM alpine:3.19 AS base

# Install all the packages we need in one go
# alpine:3.19 has the standard alpine repos (no need for --repository flag)
RUN apk add --no-cache \
        bash \
        curl \
        tini \
        nginx \
        python3 \
        py3-pip \
        ca-certificates \
        tzdata

# ============================================
# Stage 2: Add demo-specific files
# ============================================
FROM base AS demo

# Demo mode env vars
ENV AEGISGATE_MODE=demo
ENV AEGISGATE_LOG_LEVEL=info
ENV AEGISGATE_DEMO_RESET_HOURS=24
ENV AEGISGATE_DEMO_MAX_REQUESTS_PER_HOUR=100
ENV AEGISGATE_DEMO_RANDOM_SEED="aegisgate-demo-2026-06"
ENV PYTHONUNBUFFERED=1

# Copy the pre-built platform binary
# This binary was built locally from the v3.3.0-beta.2 source
COPY aegisgate-platform /usr/local/bin/aegisgate-platform
RUN chmod +x /usr/local/bin/aegisgate-platform

# Copy demo-specific files
COPY seed-data/ /opt/aegisgate-demo/seed-data/
COPY email-signup/ /opt/aegisgate-demo/email-signup/
COPY scripts/ /opt/aegisgate-demo/scripts/
COPY nginx/ /opt/aegisgate-demo/nginx/
COPY scripts/demo-banner.css /opt/aegisgate-demo/demo-banner.css
COPY scripts/demo-banner.js /opt/aegisgate-demo/demo-banner.js

# Make scripts executable
RUN chmod +x /opt/aegisgate-demo/scripts/*.sh

# Create data directories (ephemeral on free tier, no disk mount)
RUN mkdir -p /data /data/signups /data/seed /data/audit && \
    chmod 777 /data /data/signups /data/seed /data/audit

# Create nginx runtime directories
RUN mkdir -p /var/log/nginx /var/lib/nginx /run/nginx /var/cache/nginx

# Expose port 80 (nginx is the public-facing service)
EXPOSE 80

# Health check (Render will hit this every 30s)
# nginx will proxy /health to the platform's dashboard port (8443)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--", "/opt/aegisgate-demo/scripts/entrypoint.sh"]
