# AegisGate Demo - Custom Dockerfile
# ======================================
#
# This Dockerfile builds the AegisGate demo environment on top of the
# official platform image. It adds:
#
#   1. Demo mode flag (--mode=demo) to make the binary start in demo mode
#   2. Sample data seeding (pre-loaded threats, MCP tools, compliance scans)
#   3. Daily reset mechanism (clears state every 24h)
#   4. Read-only admin dashboard wrapper
#   5. Email signup page (replaces the default landing)
#   6. "DEMO MODE" banner overlay on all pages
#   7. Health checks and graceful shutdown
#
# The base image is the official AegisGate v3.3.0-beta.2 platform image.
# This Dockerfile is layered on top — it doesn't rebuild the platform.

# ============================================
# Stage 1: Base image (the actual platform)
# ============================================
FROM ghcr.io/aegisgatesecurity/aegisgate-platform:main AS base

# Verify the base image
# The platform binary is at /usr/local/bin/aegisgate-platform in the
# production stage of the platform's Dockerfile.
RUN /usr/local/bin/aegisgate-platform --version || echo "Base image OK (binary present at /usr/local/bin/aegisgate-platform)"

# ============================================
# Stage 2: Add demo-specific files
# ============================================
FROM base AS demo

# Demo mode requires these environment variables
# (set via docker-compose or Render.com env)
ENV AEGISGATE_MODE=demo
ENV AEGISGATE_LOG_LEVEL=info
ENV AEGISGATE_DEMO_RESET_HOURS=24
ENV AEGISGATE_DEMO_MAX_REQUESTS_PER_HOUR=100
ENV AEGISGATE_DEMO_RANDOM_SEED="aegisgate-demo-2026-06"

# Install minimal tools for the demo wrapper script
# The base image is Alpine (per the platform's Dockerfile), so we use apk.
# The `|| true` ensures the build doesn't fail if a package isn't available
# (we want a working demo, not a perfect install).
# The 2>/dev/null suppresses error output from apk repos that aren't configured.
RUN apk add --no-cache \
        bash \
        curl \
        tini \
        nginx \
        python3 \
        py3-pip \
        ca-certificates 2>/dev/null || \
    (echo "[WARN] apk install failed, trying without nginx..." && \
     apk add --no-cache bash curl tini python3 py3-pip ca-certificates 2>/dev/null) || \
    echo "[WARN] All package installs failed, continuing without nginx"

# Create nginx directories (needed if nginx was just installed)
RUN mkdir -p /var/log/nginx /var/lib/nginx /run/nginx /var/cache/nginx 2>/dev/null || true

# Copy demo-specific files
COPY seed-data/ /opt/aegisgate-demo/seed-data/
COPY email-signup/ /opt/aegisgate-demo/email-signup/
COPY scripts/ /opt/aegisgate-demo/scripts/
COPY nginx/ /opt/aegisgate-demo/nginx/

# Make scripts executable
RUN chmod +x /opt/aegisgate-demo/scripts/*.sh 2>/dev/null || true

# Create directories for runtime state
RUN mkdir -p /data /data/signups /data/seed /data/reset && \
    chmod 777 /data /data/signups /data/seed /data/reset

# Add a "DEMO MODE" banner to the platform's web UI
# (we do this by overlaying a CSS file that adds the banner via JS)
COPY scripts/demo-banner.css /opt/aegisgate-demo/demo-banner.css
COPY scripts/demo-banner.js /opt/aegisgate-demo/demo-banner.js

# Expose port 80 for nginx (the public-facing reverse proxy)
# Internal ports (8080 platform, 8083 signup, 8443 dashboard) are NOT exposed
# to the public; they're only accessible to nginx within the container
EXPOSE 80

# Health check: verify the platform is responding
# (uses the platform's built-in /health endpoint, which nginx proxies)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Use tini for proper signal handling (if available)
# Falls back to the platform's own signal handling
ENTRYPOINT ["/sbin/tini", "--", "/opt/aegisgate-demo/scripts/entrypoint.sh"]
