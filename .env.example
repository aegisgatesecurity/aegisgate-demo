# AegisGate Demo - Environment Variables (Example)
# ==================================================
#
# Copy this file to .env and fill in the values. NEVER commit
# the .env file (it's in .gitignore).
#
# These are also set in render.yaml for the Render.com deployment.

# ==========================================
# Demo mode configuration
# ==========================================
AEGISGATE_MODE=demo
AEGISGATE_DEMO_RESET_HOURS=24
AEGISGATE_DEMO_MAX_REQUESTS_PER_HOUR=100
AEGISGATE_DEMO_RANDOM_SEED=aegisgate-demo-2026-06

# ==========================================
# Platform configuration
# ==========================================
AEGISGATE_LOG_LEVEL=info
AEGISGATE_TIER=developer
AEGISGATE_TARGET=http://httpbin.org:80
AEGISGATE_EMBEDDED_MCP=true

# ==========================================
# Email signup notifications (REQUIRED for production)
# ==========================================
# Option A: Direct Resend API integration (RECOMMENDED)
# -------------------------------------------------------
# Get your API key at https://resend.com/api-keys
# Emails will be sent directly via Resend when someone signs up.
# You must verify your domain in Resend or use test mode first.
#
# Test mode (works immediately, no domain verification):
#   AEGISGATE_RESEND_FROM_EMAIL=onboarding@resend.dev
#
# Production mode (requires domain verification in Resend):
#   AEGISGATE_RESEND_FROM_EMAIL=notifications@yourdomain.com
#
AEGISGATE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AEGISGATE_RESEND_TO_EMAIL=security@aegisgatesecurity.io
AEGISGATE_RESEND_FROM_EMAIL=onboarding@resend.dev

# Option B: Webhook URL (legacy, use if not using Resend)
# -------------------------------------------------------
# This webhook URL receives a POST request for every signup.
# Without this set (and without Resend), signups are stored locally only.
#
# Options:
#   - Webhook.site (testing): https://webhook.site/your-unique-id
#   - Pipedream: https://m.pipedream.net/your-workflow
#   - Custom: Your own HTTPS endpoint
#
# For Render.com deployment: Set this in the Render dashboard
# (Environment tab) — do NOT commit the actual value to git.
#
# Leave blank for local dev only (signups stored locally, no notifications)
EMAIL_WEBHOOK_URL=

# ==========================================
# Cloudflare Turnstile (anti-bot, optional)
# ==========================================
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# CF_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# CF_TURNSTILE_SECRET_KEY=0x4AAAAAAA...
