# AegisGate Demo - Environment Variables (Example)
# ==================================================
#
# Copy this file to .env and fill in the values. NEVER commit
# the .env file (it's in .gitignore).
#
# These are also set in render.yaml for the Render.com deployment.

# ==========================================
# Demo mode configuration
# ==========================================
AEGISGATE_MODE=demo
AEGISGATE_DEMO_RESET_HOURS=24
AEGISGATE_DEMO_MAX_REQUESTS_PER_HOUR=100
AEGISGATE_DEMO_RANDOM_SEED=aegisgate-demo-2026-06

# ==========================================
# Platform configuration
# ==========================================
AEGISGATE_LOG_LEVEL=info
AEGISGATE_TIER=developer
AEGISGATE_TARGET=http://httpbin.org:80
AEGISGATE_EMBEDDED_MCP=true

# ==========================================
# Email signup (set this to forward signups)
# ==========================================
# Get a free webhook at https://webhook.site
# Or use Mailgun/SendGrid:
#   EMAIL_WEBHOOK_URL=https://api.mailgun.net/v3/yourdomain.com/messages
#
# Optional: leave blank to only store locally
EMAIL_WEBHOOK_URL=

# ==========================================
# Cloudflare Turnstile (anti-bot, optional)
# ==========================================
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# CF_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# CF_TURNSTILE_SECRET_KEY=0x4AAAAAAA...
